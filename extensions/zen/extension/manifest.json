{
  "manifest_version": 3,
  "name": "BetterWinControl — Zen Companion",
  "version": "0.2.0",
  "description": "Keep Zen ready for your local BetterWinControl controller, which connects to a verified window when requested.",
  "permissions": ["nativeMessaging", "tabs", "scripting", "storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {"scripts": ["protocol.js", "adapter.js", "background.js"]},
  "action": {"default_title": "BetterWinControl: enable readiness and allow this site"},
  "options_ui": {"page": "options.html", "open_in_tab": true},
  "browser_specific_settings": {
    "gecko": {
      "id": "zen-companion@betterwincontrol.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {"required": ["browsingActivity", "websiteActivity", "websiteContent"]}
    }
  }
}
